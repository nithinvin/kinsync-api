# KinSync API — systemd unit.
# Installed on the VM as /etc/systemd/system/kinsync-api.service.
# Runbook: https://github.com/nithinvin/kinsync-docs/blob/main/runbooks/deploy-api.md
[Unit]
Description=KinSync API (FastAPI/Uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=kinsync
Group=kinsync
WorkingDirectory=/opt/kinsync-api
EnvironmentFile=/opt/kinsync-api/.env
ExecStart=/opt/kinsync-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Basic sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
